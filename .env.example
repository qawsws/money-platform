# Local development defaults to SQLite when DATABASE_URL is empty.
AUTH_PORT=3001
JWT_SECRET=change-me-long-random-secret

# Production PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@host:port/database
DATABASE_SSL=false

# Optional separate API origin for a split frontend deployment.
VITE_API_BASE=
VITE_USE_MOCKS=false

# Server-only AI settings. Never expose this with a VITE_ prefix.
AI_ENABLED=false
OPENAI_API_KEY=optional-openai-key-placeholder
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=20000
AI_CACHE_TTL_MS=600000
AI_CACHE_MAX_ENTRIES=200
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20

AI_MAX_OPENAI_CALLS_PER_DAY=30
AI_MAX_OPENAI_CALLS_PER_USER_PER_DAY=10
AI_MAX_OUTPUT_TOKENS=500
AI_CACHE_TTL_SECONDS=21600

